# --- Build Artifacts ---
# The directory where Cargo stores compiled binaries and dependencies
/target/

# Static web demo output (`cargo xtask build-web`); published to the
# gh-pages branch instead of being committed on this branch.
/docs/


# --- Backup/Temporary Files ---
# Generated by various editors or the OS
**/*.rs.bk
*.swp
*~
.DS_Store

# --- IDE/Editor Specific ---
# JetBrains (IntelliJ, RustRover)
.idea/
*.iml

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Optional/Contextual ---
# If you are using 'cargo-expand'
tests/*.expanded.rs

# If you use 'cargo-tarpaulin' for code coverage
tarpaulin-report.html
cargo-tester-*.json
/.claude/
